<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>ai.creator-os.aicos</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/ai-creator-os/aicos</string>
    <string>-addr</string>
    <string>:8080</string>
    <string>-data</string>
    <string>/opt/ai-creator-os/data</string>
  </array>
  <key>WorkingDirectory</key><string>/opt/ai-creator-os</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/opt/ai-creator-os/data/aicos.log</string>
  <key>StandardErrorPath</key><string>/opt/ai-creator-os/data/aicos.err</string>
</dict>
</plist>
