#!/bin/bash
# AI Creator OS — double-click launcher (macOS Apple Silicon).
# Starts the aicos server, then opens the dashboard in your browser.
# No Docker, no auto-start: you open this app when you want it ON.
set -euo pipefail

APP_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
RES_DIR="$APP_DIR/AI Creator OS.app/Contents/Resources"
DATA_DIR="$APP_DIR/data"
mkdir -p "$DATA_DIR"

# Stop a previous instance started by this launcher (if any).
if [ -f "$DATA_DIR/aicos.pid" ]; then
  OLD_PID="$(cat "$DATA_DIR/aicos.pid" 2>/dev/null || true)"
  if [ -n "${OLD_PID:-}" ] && kill -0 "$OLD_PID" 2>/dev/null; then
    kill "$OLD_PID" 2>/dev/null || true
    sleep 1
  fi
  rm -f "$DATA_DIR/aicos.pid"
fi

"$RES_DIR/aicos" -addr 127.0.0.1:8080 -data "$DATA_DIR" >>"$DATA_DIR/aicos.log" 2>&1 &
echo $! > "$DATA_DIR/aicos.pid"

# Wait for the server, then open the dashboard.
for i in $(seq 1 30); do
  if curl -sf -o /dev/null http://127.0.0.1:8080/ 2>/dev/null; then
    open "http://127.0.0.1:8080/"
    exit 0
  fi
  sleep 1
done

osascript -e 'display alert "AI Creator OS" message "Không mở được dashboard. Xem log tại data/aicos.log."'
exit 1
