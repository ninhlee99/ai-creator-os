# Runtime
APP_ENV=development
DRY_RUN=true
DATABASE_PATH=./data/ledger.db
TIMEZONE=Asia/Ho_Chi_Minh
DAILY_API_BUDGET_USD=5
KILL_SWITCH=false
AICOS_TRUST_CLOUDFLARE_IP=false

# Gemini text and voice for TikTok video production
GEMINI_API_KEYS=
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=
GEMINI_TTS_MODEL=
TTS_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
AI_DISCLOSURE_TEXT=AI-generated content

# TikTok OAuth and posting
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TikTok Desktop callback; must be localhost/127.0.0.1 with an explicit port.
# Leave blank to use http://127.0.0.1:8080/publishers/tiktok/callback
TIKTOK_REDIRECT_URI=

# Optional alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
