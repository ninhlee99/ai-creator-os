# ---- core ----
APP_ENV=development          # development | production
DRY_RUN=true                 # true until checklist signed off
DATABASE_PATH=./data/ledger.db
TIMEZONE=Asia/Ho_Chi_Minh

# ---- LLM chain: free API first, local fallback ----
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# ---- TTS (provider set after research) ----
TTS_PROVIDER=
TTS_API_KEY=

# ---- avatar ----
AVATAR_PROVIDER=local-stylized
AVATAR_API_KEY=                # only if paid streaming avatar enabled

# ---- TikTok ----
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=         # VPS Web Login Kit: https://<host>/publishers/tiktok/callback
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_ACCESS_TOKEN=
TIKTOK_RTMP_URL=               # from TikTok LIVE studio / app
TIKTOK_RTMP_KEY=
AI_DISCLOSURE_TEXT=AI-generated stream

# ---- YouTube OAuth ----
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=        # VPS Web client: https://<host>/publishers/youtube/callback; local Desktop client leaves this empty

# ---- Google login for Bio virtual try-on ----
BIO_GOOGLE_CLIENT_ID=        # optional; falls back to YOUTUBE_CLIENT_ID
BIO_GOOGLE_CLIENT_SECRET=    # optional; falls back to YOUTUBE_CLIENT_SECRET
BIO_GOOGLE_REDIRECT_URI=     # VPS: https://<host>/bio/google/callback; register in Google OAuth client

# ---- governance ----
DAILY_API_BUDGET_USD=5
MAX_LIVE_MINUTES_PER_SESSION=120
KILL_SWITCH=false
AICOS_TRUST_CLOUDFLARE_IP=false # enable only behind Cloudflare Tunnel on localhost

# ---- alerting ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
