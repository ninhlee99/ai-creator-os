# ---- core ----
APP_ENV=development          # development | production
DRY_RUN=true                 # true until checklist signed off
DATABASE_PATH=./data/ledger.db
TIMEZONE=Asia/Ho_Chi_Minh

# ---- LLM chain: free API first, local fallback ----
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# ---- TTS (provider set after research) ----
TTS_PROVIDER=
TTS_API_KEY=

# ---- avatar ----
AVATAR_PROVIDER=local-stylized
AVATAR_API_KEY=                # only if paid streaming avatar enabled

# ---- TikTok ----
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_ACCESS_TOKEN=
TIKTOK_RTMP_URL=               # from TikTok LIVE studio / app
TIKTOK_RTMP_KEY=
AI_DISCLOSURE_TEXT=AI-generated stream

# ---- governance ----
DAILY_API_BUDGET_USD=5
MAX_LIVE_MINUTES_PER_SESSION=120
KILL_SWITCH=false

# ---- alerting ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
