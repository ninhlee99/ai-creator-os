      "to_port": "audio_in"
    },
    {
      "id": "e19",
      "from_node": "audio",
      "from_port": "video_out",
      "to_node": "grade",
      "to_port": "video_in"
    },
    {
      "id": "e20",
      "from_node": "grade",
      "from_port": "video_out",
      "to_node": "upscale",
      "to_port": "video_in"
    },
    {
      "id": "e21",
      "from_node": "resolution_input",
      "from_port": "value",
      "to_node": "upscale",
      "to_port": "resolution"
    },
    {
      "id": "e22",
      "from_node": "upscale",
      "from_port": "video_out",
      "to_node": "export",
      "to_port": "video_in"
    },
    {
      "id": "e23",
      "from_node": "export",
