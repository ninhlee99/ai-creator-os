{
  "id": "preset_viral_dance",
  "name": "TikTok Viral Dance",
  "description": "Phân tích chuyển động video Radar, khóa danh tính từ ảnh kênh, render từng đoạn bằng Muse AI, giữ audio nguồn và xuất video hoàn chỉnh.",
  "category": "viral",
  "is_preset": true,
  "nodes": [
    {
      "id": "video",
      "type": "video_source",
      "title": "1. Video TikTok Radar",
      "category": "input",
      "x": 40,
      "y": 340,
      "params": {
        "require_radar_dance": true,
        "video_path": "",
        "video_url": ""
      }
    },
    {
      "id": "dance",
      "type": "dance_motion_extractor",
      "title": "2. Phân tích chuyển động nguồn",
      "category": "process",
      "x": 360,
      "y": 160,
      "params": {
        "dance_style": "",
        "keyframe_count": 6,
        "require_audio": true,
        "strict_analysis": false,
        "analysis_timeout_seconds": 25
      }
    },
    {
      "id": "split",
      "type": "video_split",
      "title": "3. Chia video thành shot Muse",
      "category": "process",
      "x": 360,
      "y": 520,
      "params": {
        "max_segment_seconds": 10,
        "require_audio": true
      }
    },
    {
      "id": "character",
      "type": "character_input",
      "title": "4. Ảnh nhân vật kênh",
      "category": "input",
      "x": 40,
      "y": 40,
      "params": {
        "account_id": 0,
        "model_name": "",
        "model_path": ""
      }
    },
    {
      "id": "outfit",
      "type": "virtual_tryon",
      "title": "5. Hướng trang phục",
      "category": "process",
      "x": 360,
      "y": 40,
      "params": {
        "outfit_name": "",
        "prompt": "Wardrobe direction: {{fit_style}}. Preserve the supplied character's face, hair and body proportions."
      }
    },
    {
      "id": "environment",
      "type": "scene_environment",
      "title": "6. Bối cảnh",
      "category": "process",
      "x": 700,
      "y": 40,
      "params": {
        "location_type": "neon_dance_studio",
        "custom_location": "",
        "depth_of_field": "cinematic_bokeh",
        "prompt": "{{location_type}} background. {{custom_location}} Keep the character clearly visible and preserve dance framing."
      }
    },
    {
      "id": "lighting",
      "type": "lighting_atmosphere",
      "title": "7. Ánh sáng",
      "category": "lighting",
      "x": 1040,
      "y": 40,
      "params": {
        "color_temperature": "cyber_neon_magenta",
        "light_intensity": "dramatic_contrast",
        "time_of_day": "dynamic_stage_lights",
        "prompt": "{{time_of_day}} stage lighting with {{color_temperature}} color temperature and {{light_intensity}} intensity. Keep the face and outfit clearly visible."
      }
    },
    {
      "id": "retarget",
      "type": "dance_retarget",
      "title": "8. Prompt chuyển động có thể tùy chỉnh",
      "category": "process",
      "x": 1380,
      "y": 200,
      "params": {
        "dance_type": "TikTok dance",
        "expression": "confident",
        "prompt_template": "Create a vertical 9:16 dance shot. Follow only the movement observed in the attached source video: {{movement_analysis}}. Style: {{dance_type}}. Expression: {{expression}}. Outfit: {{outfit_desc}}. Setting: {{environment_desc}}. Lighting: {{lighting_desc}}. Use supplied character photos as the sole source of identity. One adult subject, realistic anatomy and motion."
      }
    },
    {
      "id": "render_map",
      "type": "workflow_map",
      "title": "9. Muse AI render từng shot",
      "category": "workflow",
      "x": 1740,
      "y": 380,
      "params": {
        "workflow_id": "preset_muse_viral_shot",
        "item_input_map": {
          "segment_video": "video_path",
          "duration": "duration_seconds"
        },
        "shared_image_input_key": "reference_images",
        "result_output_key": "video",
        "max_items": 20
      }
    },
    {
      "id": "concat",
      "type": "concat_scenes",
      "title": "10. Ghép shot theo thứ tự",
      "category": "process",
      "x": 2100,
      "y": 380,
      "params": {}
    },
    {
      "id": "audio",
      "type": "audio_merge",
      "title": "11. Giữ âm thanh video Radar",
      "category": "process",
      "x": 2440,
      "y": 380,
      "params": {
        "audio_codec": "aac"
      }
    },
    {
      "id": "grade",
      "type": "cinematic_color_grading",
      "title": "12. Cân màu",
      "category": "post",
      "x": 2780,
      "y": 380,
      "params": {
        "contrast_boost": 1.08,
        "saturation": 1.04
      }
    },
    {
      "id": "upscale",
      "type": "video_upscale",
      "title": "13. Xuất độ phân giải",
      "category": "process",
      "x": 3120,
      "y": 380,
      "params": {
        "resolution": "4k",
        "crf": 18
      }
    },
    {
      "id": "export",
      "type": "video_output",
      "title": "14. Xuất video Viral",
      "category": "output",
      "x": 3460,
      "y": 380,
      "params": {
        "title": "TikTok Dance Video"
      }
    },
    {
      "id": "fit_input",
      "type": "workflow_input",
      "title": "Phong cách trang phục",
      "category": "workflow",
      "x": 40,
      "y": 700,
      "params": {
        "key": "fit_style",
        "label": "Phong cách trang phục",
        "value_type": "text",
        "required": false,
        "value": "Trang phục biểu diễn K-pop"
      }
    },
    {
      "id": "resolution_input",
      "type": "workflow_input",
      "title": "Độ phân giải đầu ra",
      "category": "workflow",
      "x": 700,
      "y": 700,
      "params": {
        "key": "resolution",
        "label": "Độ phân giải",
        "value_type": "text",
        "required": false,
        "value": "4k",
        "options": [
          "1080p",
          "4k",
          "8k"
        ]
      }
    },
    {
      "id": "workflow_output",
      "type": "workflow_output",
      "title": "Video thành phẩm",
      "category": "workflow",
      "x": 3800,
      "y": 380,
      "params": {
        "key": "video",
        "label": "Video thành phẩm",
        "value_type": "video"
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from_node": "video",
      "from_port": "video_path",
      "to_node": "dance",
      "to_port": "video_in"
    },
    {
      "id": "e2",
      "from_node": "video",
      "from_port": "video_path",
      "to_node": "split",
      "to_port": "video_in"
    },
    {
      "id": "e3",
      "from_node": "character",
      "from_port": "character_image",
      "to_node": "outfit",
      "to_port": "character_image"
    },
    {
      "id": "e4",
      "from_node": "fit_input",
      "from_port": "value",
      "to_node": "outfit",
      "to_port": "fit_style"
    },
    {
      "id": "e5",
      "from_node": "outfit",
      "from_port": "fitted_image",
      "to_node": "environment",
      "to_port": "character_image"
    },
    {
      "id": "e6",
      "from_node": "environment",
      "from_port": "environment_desc",
      "to_node": "lighting",
      "to_port": "environment_desc"
    },
    {
      "id": "e7",
      "from_node": "character",
      "from_port": "character_image",
      "to_node": "retarget",
      "to_port": "character_image"
    },
    {
      "id": "e8",
      "from_node": "character",
      "from_port": "character_images",
      "to_node": "retarget",
      "to_port": "character_images"
    },
    {
      "id": "e9",
      "from_node": "dance",
      "from_port": "motion_data",
      "to_node": "retarget",
      "to_port": "motion_data"
    },
    {
      "id": "e10",
      "from_node": "environment",
      "from_port": "environment_desc",
      "to_node": "retarget",
      "to_port": "environment_desc"
    },
    {
      "id": "e11",
      "from_node": "lighting",
      "from_port": "lighting_desc",
      "to_node": "retarget",
      "to_port": "lighting_desc"
    },
    {
      "id": "e12",
      "from_node": "outfit",
      "from_port": "outfit_desc",
      "to_node": "retarget",
      "to_port": "outfit_desc"
    },
    {
      "id": "e13",
      "from_node": "split",
      "from_port": "segments",
      "to_node": "render_map",
      "to_port": "items"
    },
    {
      "id": "e14",
      "from_node": "retarget",
