      "to_node": "retarget",
      "to_port": "motion_data"
    },
    {
      "id": "e9_keyframes",
      "from_node": "dance",
      "from_port": "keyframes",
      "to_node": "retarget",
      "to_port": "keyframes"
    },
    {
      "id": "e10",
      "from_node": "environment",
      "from_port": "environment_desc",
      "to_node": "retarget",
      "to_port": "environment_desc"
    },
    {
      "id": "e11",
      "from_node": "lighting",
      "from_port": "lighting_desc",
      "to_node": "retarget",
      "to_port": "lighting_desc"
    },
    {
      "id": "e12",
      "from_node": "outfit",
      "from_port": "outfit_desc",
      "to_node": "retarget",
      "to_port": "outfit_desc"
    },
    {
      "id": "e12_character_images",
      "from_node": "retarget",
      "from_port": "character_images",
      "to_node": "split",
      "to_port": "character_images"
    },
    {
      "id": "e12_motion_keyframes",
      "from_node": "retarget",
      "from_port": "motion_keyframes",
      "to_node": "split",
      "to_port": "motion_keyframes"
    },
    {
      "id": "e12_prompt_context",
      "from_node": "retarget",
      "from_port": "prompt_context",
      "to_node": "split",
      "to_port": "prompt_context"
    },
    {
      "id": "e13",
      "from_node": "split",
      "from_port": "segments",
      "to_node": "render_map",
      "to_port": "items"
    },
    {
      "id": "e16",
      "from_node": "render_map",
      "from_port": "results",
      "to_node": "concat",
      "to_port": "scenes"
    },
    {
      "id": "e17",
      "from_node": "concat",
      "from_port": "master_video",
      "to_node": "audio",
      "to_port": "video_in"
    },
    {
      "id": "e18",
      "from_node": "split",
      "from_port": "audio_out",
