{
  "id": "preset_viral_dance",
  "name": "TikTok Viral Dance",
  "description": "Phân tích chuyển động video Radar, khóa danh tính từ ảnh kênh, render từng đoạn bằng Muse AI, giữ audio nguồn và xuất video hoàn chỉnh.",
  "category": "viral",
  "is_preset": true,
  "nodes": [
    {
      "id": "video",
      "type": "video_source",
      "title": "1. Video TikTok Radar",
      "category": "input",
      "x": 40,
      "y": 340,
      "params": {
        "require_radar_dance": true,
        "video_path": "",
        "video_url": ""
      }
    },
    {
      "id": "dance",
      "type": "dance_motion_extractor",
      "title": "2. Phân tích chuyển động nguồn",
      "category": "process",
      "x": 360,
      "y": 160,
      "params": {
        "dance_style": "",
        "keyframe_count": 12,
        "require_audio": true,
        "strict_analysis": true,
        "analysis_timeout_seconds": 90
      }
    },
    {
      "id": "split",
      "type": "video_split",
      "title": "3. Chia video thành shot Muse",
      "category": "process",
      "x": 360,
      "y": 520,
      "params": {
        "max_segment_seconds": 10,
        "require_audio": true
      }
    },
    {
      "id": "character",
      "type": "character_input",
      "title": "4. Ảnh nhân vật kênh",
      "category": "input",
      "x": 40,
      "y": 40,
      "params": {
        "account_id": 0,
        "model_name": "",
        "model_path": ""
      }
    },
    {
      "id": "outfit",
      "type": "virtual_tryon",
      "title": "5. Hướng trang phục",
      "category": "process",
      "x": 360,
      "y": 40,
      "params": {
        "outfit_name": "",
        "prompt": "Replace only the performer's identity with the selected channel character. Preserve the exact outfit, clothing colors, fit, accessories and body pose visible in the source video. Do not add logos or change wardrobe. Preserve the selected character's face, hair and body proportions. Wardrobe direction: {{fit_style}}."
      }
    },
    {
      "id": "environment",
      "type": "scene_environment",
      "title": "6. Bối cảnh",
      "category": "process",
      "x": 700,
      "y": 40,
      "params": {
        "location_type": "custom",
        "custom_location": "the exact original source-video location, background, visible objects and spatial layout",
        "depth_of_field": "preserve source video",
        "prompt": "Preserve the source TikTok video's exact location, background, visible objects, spatial layout and camera framing. Do not create a studio, relocate the performer, add or remove scene objects, or change the background."
      }
    },
    {
      "id": "lighting",
      "type": "lighting_atmosphere",
      "title": "7. Ánh sáng",
      "category": "lighting",
      "x": 1040,
      "y": 40,
      "params": {
        "color_temperature": "preserve source video",
        "light_intensity": "preserve source video",
        "time_of_day": "preserve source video",
        "prompt": "Preserve the source video's existing light direction, brightness, color, exposure and shadows. Do not add stage lights, neon, relighting or a new color grade. Keep the replacement character naturally integrated into the original scene."
      }
    },
    {
      "id": "retarget",
      "type": "dance_retarget",
      "title": "8. Prompt chuyển động có thể tùy chỉnh",
      "category": "process",
      "x": 1380,
      "y": 200,
      "params": {
        "dance_type": "reproduce the source choreography exactly",
        "expression": "match the source performer's visible expression",
        "prompt_template": "Create a vertical 9:16 video-to-video full-performer replacement of the attached TikTok source. Preserve the source video's exact scene, background, props, lighting, framing, camera movement, performer position and path, choreography, pose order, timing, transitions and cuts. Replace only the performer's identity with the selected channel character; keep the source performer's clothing, colors, fit and accessories unchanged. Do not stage a new dance, change the location, invent actions, alter camera framing, add props, or restyle the video. Use the attached source video as the motion and scene authority. Follow the observed movement analysis: {{movement_analysis}}. The final {{motion_keyframe_count}} chronological motion-reference images correspond to source times {{motion_keyframe_timestamps}}; reproduce their poses and hand positions at those times and interpolate only the visible transitions. Style: {{dance_type}}. Expression: {{expression}}. Outfit: {{outfit_desc}}. Source scene: {{environment_desc}}. Source lighting: {{lighting_desc}}. Use the selected channel-character photos as the sole identity reference. Keep one realistic adult performer with stable face, hair, body proportions and anatomy. No captions, added text or watermark."
      }
    },
    {
      "id": "render_map",
      "type": "workflow_map",
      "title": "9. Muse AI render từng shot",
      "category": "workflow",
      "x": 1740,
      "y": 380,
      "params": {
        "workflow_id": "preset_muse_viral_shot",
        "item_input_map": {
          "segment_video": "video_path",
          "duration": "duration_seconds",
          "reference_images": "reference_images",
          "variables": "variables"
        },
        "result_output_key": "video",
        "max_items": 20,
        "share_muse_thread": true,
        "previous_video_frame_input_key": "reference_images",
        "previous_video_frame_insert_at": 1,
        "previous_video_frame_variables_key": "variables"
      }
    },
    {
      "id": "concat",
      "type": "concat_scenes",
      "title": "10. Ghép shot theo thứ tự",
      "category": "process",
      "x": 2100,
      "y": 380,
      "params": {
        "fit_mode": "cover"
      }
    },
    {
      "id": "audio",
      "type": "audio_merge",
      "title": "11. Giữ âm thanh video Radar",
      "category": "process",
      "x": 2440,
      "y": 380,
      "params": {
        "audio_codec": "aac"
      }
    },
    {
      "id": "grade",
      "type": "cinematic_color_grading",
      "title": "12. Cân màu",
      "category": "post",
      "x": 2780,
      "y": 380,
      "params": {
        "contrast_boost": 1.0,
        "saturation": 1.0
      }
    },
    {
      "id": "upscale",
      "type": "video_upscale",
      "title": "13. Xuất độ phân giải",
      "category": "process",
      "x": 3120,
      "y": 380,
      "params": {
        "resolution": "4k",
        "crf": 18,
        "fit_mode": "cover"
      }
    },
    {
      "id": "export",
      "type": "video_output",
      "title": "14. Xuất video Viral",
      "category": "output",
      "x": 3460,
      "y": 380,
      "params": {
        "title": "TikTok Dance Video"
      }
    },
    {
      "id": "fit_input",
      "type": "workflow_input",
      "title": "Phong cách trang phục",
      "category": "workflow",
      "x": 40,
      "y": 700,
      "params": {
        "key": "fit_style",
        "label": "Phong cách trang phục",
        "value_type": "text",
        "required": false,
        "value": "Match the source performer's exact visible outfit and accessories; do not change clothing."
      }
    },
    {
      "id": "resolution_input",
      "type": "workflow_input",
      "title": "Độ phân giải đầu ra",
      "category": "workflow",
      "x": 700,
      "y": 700,
      "params": {
        "key": "resolution",
        "label": "Độ phân giải",
        "value_type": "text",
        "required": false,
        "value": "4k",
        "options": [
          "1080p",
          "4k",
          "8k"
        ]
      }
    },
    {
      "id": "workflow_output",
      "type": "workflow_output",
      "title": "Video thành phẩm",
      "category": "workflow",
      "x": 3800,
      "y": 380,
      "params": {
        "key": "video",
        "label": "Video thành phẩm",
        "value_type": "video"
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from_node": "video",
      "from_port": "video_path",
      "to_node": "dance",
      "to_port": "video_in"
    },
    {
      "id": "e2",
      "from_node": "video",
      "from_port": "video_path",
      "to_node": "split",
      "to_port": "video_in"
    },
    {
      "id": "e3",
      "from_node": "character",
      "from_port": "character_image",
      "to_node": "outfit",
      "to_port": "character_image"
    },
    {
      "id": "e4",
      "from_node": "fit_input",
      "from_port": "value",
      "to_node": "outfit",
      "to_port": "fit_style"
    },
    {
      "id": "e5",
      "from_node": "outfit",
      "from_port": "fitted_image",
      "to_node": "environment",
      "to_port": "character_image"
    },
    {
      "id": "e6",
      "from_node": "environment",
      "from_port": "environment_desc",
      "to_node": "lighting",
      "to_port": "environment_desc"
    },
    {
      "id": "e7",
      "from_node": "character",
      "from_port": "character_image",
      "to_node": "retarget",
      "to_port": "character_image"
    },
    {
      "id": "e8",
      "from_node": "character",
      "from_port": "character_images",
      "to_node": "retarget",
      "to_port": "character_images"
    },
    {
      "id": "e9",
      "from_node": "dance",
