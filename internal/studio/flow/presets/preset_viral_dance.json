{
  "id": "preset_viral_dance",
  "name": "TikTok Viral Sexy Dance",
  "description": "Phân tích chuyển động từ video nhảy đã xác thực trong Radar, chọn ảnh nhân vật và outfit tham chiếu, tạo prompt video, render, ghép audio, cân màu, upscale và xuất file",
  "category": "viral",
  "is_preset": true,
  "nodes": [
    {
      "id": "node_video",
      "type": "video_source",
      "title": "1. Video TikTok Radar gốc (Trend sexy dance)",
      "category": "input",
      "x": 60,
      "y": 460,
      "params": {
        "require_radar_dance": true,
        "video_path": "",
        "video_url": ""
      }
    },
    {
      "id": "node_dance_extract",
      "type": "dance_motion_extractor",
      "title": "2. Phân tích chuyển động & tách beat",
      "category": "process",
      "x": 440,
      "y": 460,
      "params": {
        "dance_style": "",
        "keyframe_count": 5,
        "require_audio": true
      }
    },
    {
      "id": "node_char",
      "type": "character_input",
      "title": "3. Ảnh nhân vật đã chọn",
      "category": "input",
      "x": 60,
      "y": 80,
      "params": {
        "account_id": 0,
        "model_name": "",
        "model_path": ""
      }
    },
    {
      "id": "node_tryon",
      "type": "virtual_tryon",
      "title": "4. Chuẩn bị outfit tham chiếu",
      "category": "process",
      "x": 440,
      "y": 80,
      "params": {
        "outfit_name": "Set đồ nhảy K-pop sexy ôm sát body tôn dáng",
        "prompt": "Describe reference outfit {{outfit_name}} in style {{fit_style}}. Preserve garment details from the reference image and never change the model identity. Return one concise visual description in English."
      }
    },
    {
      "id": "node_env",
      "type": "scene_environment",
      "title": "5. Không gian / Bối cảnh phòng tập Neon",
      "category": "process",
      "x": 820,
      "y": 180,
      "params": {
        "depth_of_field": "cinematic_bokeh",
        "location_type": "neon_dance_studio",
        "prompt": "Create a concise visual background prompt for {{location_type}}. Additional location details: {{custom_location}}. Keep a polished fashion campaign look with {{depth_of_field}} depth of field. Return only the environment description in English."
      }
    },
    {
      "id": "node_light",
      "type": "lighting_atmosphere",
      "title": "6. Thời gian & Ánh sáng sân khấu biểu diễn",
      "category": "process",
      "x": 1200,
      "y": 180,
      "params": {
        "color_temperature": "cyber_neon_magenta",
        "light_intensity": "dramatic_contrast",
        "time_of_day": "dynamic_stage_lights",
        "prompt": "Create a concise lighting direction for {{time_of_day}}, {{color_temperature}} color temperature, and {{light_intensity}} intensity. Match this scene: {{environment_desc}}. Return only the lighting description in English."
      }
    },
    {
      "id": "node_dance_retarget",
      "type": "dance_retarget",
      "title": "7. Tạo prompt vũ đạo từ phân tích",
      "category": "process",
      "x": 1580,
      "y": 240,
      "params": {
        "dance_type": "TikTok dance",
        "expression": "confident"
      }
    },
    {
      "id": "node_flow_video",
      "type": "google_flow_video",
      "title": "8. Google Flow Veo 2 (Render video nhảy vũ đạo)",
      "category": "ai",
      "x": 1960,
      "y": 240,
      "params": {
        "aspect": "VIDEO_ASPECT_RATIO_PORTRAIT",
        "prompt": "Create a short vertical 9:16 cinematic fashion video. Preserve subject identity and garment design. Follow this creative direction: {{input}}. Use natural movement, realistic materials, and clean editorial lighting."
      }
    },
    {
      "id": "node_audio_merge",
      "type": "audio_merge",
      "title": "9. Lồng âm thanh gốc đã bóc tách",
      "category": "process",
      "x": 2340,
      "y": 320,
      "params": {
        "audio_codec": "aac"
      }
    },
    {
      "id": "node_color_grade",
      "type": "cinematic_color_grading",
      "title": "10. Cân chỉnh ánh sáng sân khấu & Độ tương phản",
      "category": "post",
      "x": 2720,
      "y": 320,
      "params": {
        "contrast_boost": 1.15,
        "saturation": 1.08
      }
    },
    {
      "id": "node_upscale",
      "type": "video_upscale",
      "title": "11. Làm nét & Nâng chuẩn 4K UHD",
      "category": "process",
      "x": 3100,
      "y": 320,
      "params": {
        "resolution": "4k"
      }
    },
    {
      "id": "node_output",
      "type": "video_output",
      "title": "12. Xuất video Viral TikTok 9:16",
      "category": "output",
      "x": 3480,
      "y": 320,
      "params": {
        "title": "TikTok Dance Video"
      }
    },
    {
      "id": "input_fit_style",
      "type": "workflow_input",
      "title": "Phong cách cho lần chạy",
      "category": "workflow",
      "x": 140,
      "y": 580,
      "params": {
        "key": "fit_style",
        "label": "Phong cách trang phục",
        "value_type": "text",
        "required": true,
        "value": "Trang phục biểu diễn K-pop",
        "options": [
          "May đo cao cấp ôm dáng (Seamless Luxury)",
          "Trang phục biểu diễn K-pop",
          "Bodycon glamour",
          "Streetwear hiện đại",
          "Trang phục công sở thanh lịch",
          "Trang phục truyền thống",
          "Váy dạ hội"
        ],
        "help": "Chọn gợi ý hoặc tự mô tả phong cách. Giá trị chỉ dùng cho lần chạy này."
      }
    },
    {
      "id": "output_video",
      "type": "workflow_output",
      "title": "Video thành phẩm",
      "category": "workflow",
      "x": 3840,
      "y": 320,
      "params": {
        "key": "video",
        "label": "Video thành phẩm",
        "value_type": "video"
      }
    }
  ],
  "edges": [
