{
  "id": "preset_fashion_tryon",
  "name": "Fashion Lookbook · 3 góc quay",
  "description": "Chọn ảnh nhân vật và sản phẩm thật, tạo prompt outfit và ba prompt góc máy, render ba cảnh, ghép, thêm audio và xuất video",
  "category": "fashion",
  "is_preset": true,
  "nodes": [
    {
      "id": "node_char",
      "type": "character_input",
      "title": "1. Ảnh nhân vật",
      "category": "input",
      "x": 60,
      "y": 80,
      "params": {
        "account_id": 0,
        "model_name": "",
        "model_path": ""
      }
    },
    {
      "id": "node_garment",
      "type": "product_input",
      "title": "2. Sản phẩm thời trang",
      "category": "input",
      "x": 60,
      "y": 490,
      "params": {
        "affiliate_url": "",
        "preview_url": "",
        "product_image": "",
        "product_title": ""
      }
    },
    {
      "id": "node_extract",
      "type": "product_extractor",
      "title": "3. Bóc tách phom váy lụa",
      "category": "process",
      "x": 430,
      "y": 490,
      "params": {
        "refine_edges": true
      }
    },
    {
      "id": "node_tryon",
      "type": "virtual_tryon",
      "title": "4. Chuẩn bị outfit tham chiếu",
      "category": "process",
      "x": 790,
      "y": 180,
      "params": {
        "prompt": "Describe reference outfit {{outfit_name}} in style {{fit_style}}. Preserve garment details from the reference image and never change the model identity. Return one concise visual description in English."
      }
    },
    {
      "id": "node_env",
      "type": "scene_environment",
      "title": "5. Bối cảnh boutique",
      "category": "process",
      "x": 1120,
      "y": 180,
      "params": {
        "depth_of_field": "cinematic_bokeh",
        "location_type": "fashion_boutique",
        "prompt": "Create a concise visual background prompt for {{location_type}}. Additional location details: {{custom_location}}. Keep a polished fashion campaign look with {{depth_of_field}} depth of field. Return only the environment description in English."
      }
    },
    {
      "id": "node_light",
      "type": "lighting_atmosphere",
      "title": "6. Ánh sáng lookbook",
      "category": "process",
      "x": 1120,
      "y": 420,
      "params": {
        "color_temperature": "warm_golden",
        "light_intensity": "soft_diffused",
        "time_of_day": "golden_hour",
        "prompt": "Create a concise lighting direction for {{time_of_day}}, {{color_temperature}} color temperature, and {{light_intensity}} intensity. Match this scene: {{environment_desc}}. Return only the lighting description in English."
      }
    },
    {
      "id": "node_director",
      "type": "camera_angles_director",
      "title": "7. Đạo diễn 3 góc quay điện ảnh",
      "category": "camera",
      "x": 1480,
      "y": 180,
      "params": {
        "shot_style": "high-fashion editorial",
        "full_prompt_template": "High-fashion vertical 9:16 full-body campaign shot. Show {{character_name}} presenting {{product_title}}; outfit: {{outfit_desc}}. Scene: {{environment_desc}}. Lighting: {{lighting_desc}}. Natural confident movement, stable camera, photorealistic details.",
        "medium_prompt_template": "High-fashion vertical 9:16 medium shot of {{character_name}} turning naturally to present {{product_title}}; outfit: {{outfit_desc}}. Scene: {{environment_desc}}. Lighting: {{lighting_desc}}. Preserve face and garment details; elegant 35mm editorial framing.",
        "detail_prompt_template": "Vertical 9:16 fashion detail shot of {{product_title}}; outfit: {{outfit_desc}}. Show fabric texture, seams, and construction clearly. Scene: {{environment_desc}}. Lighting: {{lighting_desc}}. Keep design consistent with reference images."
      }
    },
    {
      "id": "node_flow_full",
      "type": "google_flow_video",
      "title": "8a. Render toàn thân",
      "category": "ai",
      "x": 1840,
      "y": 80,
      "params": {
        "aspect": "VIDEO_ASPECT_RATIO_PORTRAIT",
        "prompt": "Create a vertical 9:16 high-fashion campaign video, full-body framing. Preserve the same adult model, face, body proportions, and garment design. Use graceful runway movement, stable camera, natural fabric motion. Direction: {{input}}. No cuts, captions, logos, or extra subjects."
      }
    },
    {
      "id": "node_flow_medium",
      "type": "google_flow_video",
      "title": "8b. Render bán thân",
      "category": "ai",
      "x": 1840,
      "y": 260,
      "params": {
        "aspect": "VIDEO_ASPECT_RATIO_PORTRAIT",
        "prompt": "Create a vertical 9:16 high-fashion campaign video, medium framing. Preserve the same adult model and exact garment details. Show a natural turn and confident presentation, elegant camera motion, realistic fabric movement. Direction: {{input}}. No cuts, captions, logos, or extra subjects."
      }
    },
    {
      "id": "node_flow_detail",
      "type": "google_flow_video",
      "title": "8c. Render cận cảnh chất liệu",
      "category": "ai",
      "x": 1840,
      "y": 440,
      "params": {
        "aspect": "VIDEO_ASPECT_RATIO_PORTRAIT",
        "prompt": "Create a vertical 9:16 close-up fashion video focused on garment texture and construction. Keep reference design and colors exact; use a slow editorial camera move and realistic material motion. Direction: {{input}}. No cuts, captions, logos, or extra subjects."
      }
    },
    {
      "id": "node_audio",
      "type": "audio_source",
      "title": "9. Nhạc nền",
      "category": "input",
      "x": 1840,
      "y": 650,
      "params": {
        "audio_path": "",
        "audio_title": ""
      }
    },
    {
      "id": "node_concat",
      "type": "concat_scenes",
      "title": "10. Ghép ba phân cảnh",
      "category": "process",
      "x": 2220,
      "y": 180,
      "params": {}
    },
    {
      "id": "node_audio_merge",
      "type": "audio_merge",
      "title": "11. Lồng nhạc",
      "category": "process",
      "x": 2600,
      "y": 280,
      "params": {
        "audio_codec": "aac"
      }
    },
    {
      "id": "node_upscale",
      "type": "video_upscale",
      "title": "12. Làm nét & Nâng chuẩn 4K UHD",
      "category": "process",
      "x": 2980,
      "y": 280,
      "params": {
        "resolution": "4k"
      }
    },
    {
      "id": "node_output",
      "type": "video_output",
      "title": "13. Xuất video Lookbook 9:16",
      "category": "output",
      "x": 3360,
      "y": 280,
      "params": {
        "title": "Fashion Lookbook"
      }
    },
    {
      "id": "input_fit_style",
      "type": "workflow_input",
      "title": "Phong cách cho lần chạy",
      "category": "workflow",
      "x": 490,
      "y": 680,
      "params": {
        "key": "fit_style",
        "label": "Phong cách trang phục",
        "value_type": "text",
        "required": true,
        "value": "May đo cao cấp ôm dáng (Seamless Luxury)",
        "options": [
          "May đo cao cấp ôm dáng (Seamless Luxury)",
          "Trang phục biểu diễn K-pop",
          "Bodycon glamour",
          "Streetwear hiện đại",
          "Trang phục công sở thanh lịch",
          "Trang phục truyền thống",
          "Váy dạ hội"
        ],
        "help": "Chọn gợi ý hoặc tự mô tả phong cách. Giá trị chỉ dùng cho lần chạy này."
      }
    },
    {
      "id": "output_video",
      "type": "workflow_output",
      "title": "Video thành phẩm",
      "category": "workflow",
      "x": 3720,
      "y": 280,
      "params": {
        "key": "video",
        "label": "Video thành phẩm",
        "value_type": "video"
      }
    }
  ],
