{
  "id": "preset_affiliate_showcase",
  "name": "TikTok Affiliate Muse AI",
  "description": "Dùng shot plan đã duyệt, ảnh model và listing thật; render từng shot bằng Muse AI, trộn sound Radar/voiceover, master và xuất video.",
  "category": "affiliate",
  "is_preset": true,
  "nodes": [
    {
      "id": "char",
      "type": "character_input",
      "title": "1. Nhân vật kênh",
      "category": "input",
      "x": 80,
      "y": 80,
      "params": {
        "account_id": 0,
        "model_name": "",
        "model_path": ""
      }
    },
    {
      "id": "product",
      "type": "product_input",
      "title": "2. Sản phẩm listing",
      "category": "input",
      "x": 80,
      "y": 360,
      "params": {
        "affiliate_url": "",
        "product_image": "",
        "product_title": ""
      }
    },
    {
      "id": "extract",
      "type": "webai_product_extractor",
      "title": "3. Bóc tách sản phẩm (ChatGPT)",
      "category": "ai",
      "x": 460,
      "y": 780,
      "params": {
        "provider": "chatgpt",
        "model": "gpt-4o",
        "auto_crop": true,
        "refine_edges": true,
        "isolate_garment": true,
        "remove_skin": true
      }
    },
    {
      "id": "outfit",
      "type": "virtual_tryon",
      "title": "4. Outfit và ảnh tham chiếu",
      "category": "process",
      "x": 840,
      "y": 920,
      "params": {
        "outfit_name": "",
        "prompt": "Keep the selected channel character identity and use the exact product shown in the listing: {{outfit_name}}. Follow each shot's product-use mode; wear only wearable products. Preserve the product's visible category, color, silhouette, material, cut and details. Do not invent product details or claims, and do not claim a still image was edited."
      }
    },
    {
      "id": "environment",
      "type": "scene_environment",
      "title": "5. Bối cảnh",
      "category": "process",
      "x": 1220,
      "y": 920,
      "params": {
        "depth_of_field": "cinematic_bokeh",
        "location_type": "fashion_boutique",
        "custom_location": "",
        "prompt": "Use this campaign setting consistently: {{environment_desc}}. Keep the product-use action visible and believable. Avoid unrelated props, location changes, captions and signs."
      }
    },
    {
      "id": "lighting",
      "type": "lighting_atmosphere",
      "title": "6. Ánh sáng",
      "category": "lighting",
      "x": 1600,
      "y": 920,
      "params": {
        "color_temperature": "warm_golden",
        "light_intensity": "soft_diffused",
        "time_of_day": "golden_hour",
        "prompt": "Use {{light_intensity}} {{color_temperature}} lighting at {{time_of_day}}. Preserve accurate product color and texture, natural skin tone, and soft realistic shadows. Avoid flicker and dramatic color casts. Environment: {{environment_desc}}."
      }
    },
    {
      "id": "shots",
      "type": "workflow_input",
      "title": "7. Shot plan đã duyệt",
      "category": "workflow",
      "x": 80,
      "y": 640,
      "params": {
        "key": "shots",
        "label": "Shot list",
        "value_type": "any",
        "required": true,
        "value": [
          {
            "duration_seconds": 6,
            "variables": {
              "shot_prompt": "Hook shot (0-6s): Full body showcase introducing {{product_name}}. Model turns confidently to camera with an engaging smile, highlighting the overall silhouette and elegant fit."
            }
          },
          {
            "duration_seconds": 6,
            "variables": {
              "shot_prompt": "Detail shot (6-12s): Macro close-up tracking shot gliding over the fabric texture, seams, bow-knot details, and mesh layers of {{product_name}}, showcasing premium material quality."
            }
          },
          {
            "duration_seconds": 6,
            "variables": {
              "shot_prompt": "Movement shot (12-18s): Gentle twirl and 360-degree rotation showing how {{product_name}} flows dynamically with movement, emphasizing comfort and flattering waistline."
            }
          },
          {
            "duration_seconds": 6,
            "variables": {
              "shot_prompt": "Lifestyle shot (18-24s): Medium framing in natural ambient setting, posing naturally to show real-world wearability and styling versatility of {{product_name}}."
            }
          },
          {
            "duration_seconds": 6,
            "variables": {
              "shot_prompt": "Payoff CTA shot (24-30s): Warm, smiling direct-to-camera presentation, gesturing naturally toward the TikTok Shop product cart with a welcoming call to order today."
            }
          }
        ]
      }
    },
    {
      "id": "prompt_context",
      "type": "prompt_template",
      "title": "7. Context biến prompt cho mỗi shot",
      "category": "process",
      "x": 1980,
      "y": 920,
      "params": {
        "template": "{{product_title}}. {{outfit_desc}}. {{environment_desc}}. {{lighting_desc}}."
      }
    },
    {
      "id": "render_map",
      "type": "workflow_map",
      "title": "8. Muse AI render từng shot",
      "category": "workflow",
      "x": 2360,
      "y": 920,
      "params": {
        "workflow_id": "preset_muse_video_shot",
        "item_input_map": {
          "duration": "duration_seconds",
          "segment_video": "segment_video"
        },
        "shared_image_input_key": "reference_images",
        "result_output_key": "video",
        "max_items": 30,
        "merge_context_into_item": true,
        "share_muse_thread": true,
        "previous_video_frame_input_key": "reference_images",
        "previous_video_frame_insert_at": 1,
        "previous_video_frame_insert_after_reference_prefix": true,
        "previous_video_frame_variables_key": "variables"
      }
    },
    {
      "id": "concat",
      "type": "concat_scenes",
      "title": "9. Ghép shot theo thứ tự",
      "category": "process",
      "x": 2740,
      "y": 920,
      "params": {
        "fit_mode": "cover"
      }
    },
    {
      "id": "music",
      "type": "audio_source",
      "title": "10. Nhạc từ Radar",
      "category": "input",
      "x": 80,
      "y": 920,
      "params": {
        "audio_path": "",
        "audio_title": ""
      }
    },
    {
      "id": "voice",
      "type": "workflow_input",
      "title": "Voiceover tùy chọn",
      "category": "workflow",
      "x": 80,
      "y": 1200,
      "params": {
        "key": "voice_audio",
        "label": "Voiceover",
        "value_type": "audio",
        "required": false,
        "value": ""
      }
    },
    {
      "id": "duration",
      "type": "workflow_input",
      "title": "Thời lượng master",
      "category": "workflow",
      "x": 80,
      "y": 1480,
      "params": {
        "key": "duration",
        "label": "Thời lượng (giây)",
        "value_type": "number",
        "required": true,
        "value": 30
      }
    },
    {
      "id": "audio_mix",
      "type": "audio_mix",
      "title": "11. Trộn voiceover và nhạc",
      "category": "process",
      "x": 460,
      "y": 1060,
      "params": {
        "voice_volume": 1.0,
        "music_volume": 0.18,
        "duck_music": true,
        "loop_music": true,
        "normalize": true
      }
    },
    {
      "id": "audio",
      "type": "audio_merge",
      "title": "12. Ghép audio vào video",
      "category": "process",
      "x": 3120,
      "y": 920,
      "params": {
        "audio_codec": "aac"
      }
    },
    {
      "id": "grade",
      "type": "cinematic_color_grading",
      "title": "13. Cân màu",
      "category": "post",
      "x": 3500,
      "y": 920,
      "params": {
        "contrast_boost": 1.08,
        "saturation": 1.04
      }
    },
    {
      "id": "resolution",
      "type": "workflow_input",
      "title": "Độ phân giải đầu ra",
      "category": "workflow",
      "x": 80,
      "y": 1760,
      "params": {
        "key": "resolution",
        "label": "Độ phân giải",
        "value_type": "text",
        "required": false,
        "value": "4k",
        "options": [
          "1080p",
          "4k",
          "8k"
        ]
      }
    },
    {
      "id": "upscale",
      "type": "video_upscale",
      "title": "14. Master độ phân giải",
      "category": "process",
      "x": 3880,
      "y": 920,
      "params": {
        "resolution": "4k",
        "crf": 18,
        "fit_mode": "cover"
      }
    },
    {
      "id": "export",
      "type": "video_output",
      "title": "15. Xuất video Affiliate",
      "category": "output",
      "x": 4260,
      "y": 920,
      "params": {
        "title": "Affiliate Lookbook"
      }
    },
    {
      "id": "workflow_output",
      "type": "workflow_output",
      "title": "Video thành phẩm",
      "category": "workflow",
      "x": 4640,
      "y": 920,
      "params": {
        "key": "video",
        "label": "Video thành phẩm",
        "value_type": "video"
      }
    }
  ],
